require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '16.4'
use_frameworks! :linkage => :static

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  # Explicitly selecting the 'Google' subspec here (via `/Google` or `:subspecs =>`)
  # makes CocoaPods emit a broken empty PBXAggregateTarget for this pod instead of a
  # real compiled target — its Swift sources silently never get built or linked, and
  # Capacitor's native bridge then reports the plugin as "not implemented on ios" at
  # runtime. Using the bare pod name keeps the default 'Lite' subspec, which compiles
  # correctly; Google support is added below via GoogleSignIn + a Swift flag.
  pod 'CapacitorFirebaseAuthentication', :path => '../../node_modules/@capacitor-firebase/authentication'
  pod 'GoogleSignIn', '9.0.0'
  pod 'CapgoCapacitorNativeAudio', :path => '../../node_modules/@capgo/capacitor-native-audio'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)

  google_target = installer.pods_project.targets.find { |t| t.name == 'GoogleSignIn' }

  installer.pods_project.targets.each do |target|
    next unless target.name == 'CapacitorFirebaseAuthentication'
    # The default 'Lite' subspec doesn't declare GoogleSignIn as a dependency
    # (only the broken 'Google' subspec does), so add it explicitly: build
    # order dependency + framework search path, on top of the Swift flag
    # that unlocks the `import GoogleSignIn` code path.
    target.add_dependency(google_target) if google_target
    target.build_configurations.each do |config|
      flags = config.build_settings['OTHER_SWIFT_FLAGS'] || '$(inherited)'
      config.build_settings['OTHER_SWIFT_FLAGS'] = "#{flags} -DRGCFA_INCLUDE_GOOGLE"

      search_paths = config.build_settings['FRAMEWORK_SEARCH_PATHS'] || '$(inherited)'
      search_paths = [search_paths] if search_paths.is_a?(String)
      search_paths += ['"${PODS_CONFIGURATION_BUILD_DIR}/GoogleSignIn"']
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] = search_paths
    end
  end
end
