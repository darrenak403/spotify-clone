# Backend base URL, used for REST calls and the Socket.io connection
VITE_REACT_APP_BACKEND_URL=http://localhost:5000

# Firebase web app config (Firebase Console > Project Settings > General > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
