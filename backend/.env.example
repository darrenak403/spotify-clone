# PostgreSQL (Neon) — pooled connection string, used by the app at runtime (host ends in "-pooler")
DATABASE_URL=
# PostgreSQL (Neon) — direct/unpooled connection string, required by `prisma migrate` only
DIRECT_URL=

# Server
PORT=5000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK (from the service account JSON — Project Settings > Service Accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n escapes for newlines, e.g.:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Session JWT used only for the Socket.io handshake (never for REST auth) — generate a long random string
SESSION_JWT_SECRET=

# Email of the account to grant the admin custom claim to (used by `npm run set-admin-claim`)
ADMIN_EMAIL=
